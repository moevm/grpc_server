CC = gcc
CFLAGS = -Iinclude -O2 -msse4.2 -mpclmul -maes
LDFLAGS = -lrte_eal -lrte_ethdev -lrte_mempool -lrte_mbuf -lrte_bus_vdev -lpthread -lnuma -ldl

SRCS = src/dpdk_filter/main.c src/dpdk_filter/af_xdp_port.c
TARGET = main

all: $(TARGET)

$(TARGET): $(SRCS)
	$(CC) $(CFLAGS) -o $(TARGET) $(SRCS) $(LDFLAGS)

clean:
	rm -f $(TARGET)

run: $(TARGET)
	sudo ./$(TARGET) eth0

run-wlan: $(TARGET)
	sudo ./$(TARGET) wlan0

.PHONY: all clean run run-wlan