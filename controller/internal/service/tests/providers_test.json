{
  "providers": {
    "kaspersky": {
      "base_url": "https://opentip.kaspersky.com/api/v1",
      "headers": {
        "x-api-key": "KM3wxfz4TVCUx8mpeBiXhg=="
      },
      "endpoints": {
        "domain": {
          "method": "GET",
          "path": "/search/domain",
          "query": {
            "request": "{domain}"
          },
          "categories": "DomainGeneralInfo.Categories"
        },
        "ip": {
          "method": "GET",
          "path": "/search/ip",
          "query": {
            "request": "{ip}"
          },
          "categories": "IpGeneralInfo.Categories"
        }
      }
    },

    "virustotal": {
      "base_url": "https://www.virustotal.com/api/v3",
      "headers": {
        "x-apikey": "{api_key}"
      },
      "endpoints": {
        "domain": {
          "method": "GET",
          "path": "/domains/{domain}",
          "categories": "data.attributes.categories"
        },
        "ip": {
          "method": "GET",
          "path": "/ip_addresses/{ip}",
          "categories": "data.attributes.categories"
        }
      }
    }
  }
}