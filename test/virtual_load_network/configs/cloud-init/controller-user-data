#cloud-config
mounts:
  - ["host_share", "/mnt", "9p", "trans=virtio,version=9p2000.L", "0", "0"]
runcmd:
  - |
    cat > /etc/systemd/system/controller.service <<UNIT
    [Unit]
    Description=gRPC Controller
    After=local-fs.target
    RequiresMountsFor=/mnt
    [Service]
    Type=simple
    WorkingDirectory=/mnt
    ExecStart=/mnt/controller
    StandardOutput=file:/mnt/controller.log
    StandardError=file:/mnt/controller.log
    Restart=on-failure
    RestartSec=5
    [Install]
    WantedBy=multi-user.target
    UNIT
  - systemctl daemon-reload
  - systemctl enable --now controller.service
